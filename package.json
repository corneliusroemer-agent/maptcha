{
  "name": "maptcha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && npm run build --prefix variants/space-bunny && node scripts/assemble.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ol": "^10.11.0",
    "ol-mapbox-style": "^13.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
